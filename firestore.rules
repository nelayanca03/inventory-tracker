rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /inventory_items/{itemId} {
      allow read, write: if true;
    }
    match /app_settings/{settingsId} {
      allow read, write: if true;
    }
    match /user_accounts/{userId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
